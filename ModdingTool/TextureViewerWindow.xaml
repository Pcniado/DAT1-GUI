<Window x:Class="ModdingTool.Windows.TextureViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Texture Viewer"
        Height="600" Width="800"
        Background="#1E1E1E"
        Foreground="White"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI"
        FontSize="13">

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- Red button stack -->
		<StackPanel Orientation="Horizontal" Margin="10" Grid.Row="0">
			<Button Content="Browse Texture"
                    Click="OnBrowseTexture_Click"
                    Background="#B22222"
                    Foreground="White"
                    Margin="0,0,10,0"
                    Padding="10,4"
                    BorderBrush="#FF0000"
                    FontWeight="Bold" />
			<Button Content="Export PNG"
                    Click="OnExportPng_Click"
                    Background="#B22222"
                    Foreground="White"
                    Margin="0,0,10,0"
                    Padding="10,4"
                    BorderBrush="#FF0000"
                    FontWeight="Bold" />
			<Button Content="Import PNG"
                    Click="OnImportPng_Click"
                    Background="#B22222"
                    Foreground="White"
                    Padding="10,4"
                    BorderBrush="#FF0000"
                    FontWeight="Bold" />
		</StackPanel>

		<!-- Image preview area -->
		<Border Grid.Row="1"
                Margin="10"
                BorderBrush="#444"
                BorderThickness="1"
                Background="#2A2A2A">
			<ScrollViewer x:Name="ImageScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
				<Image Name="TextureImage" Stretch="Uniform"/>
			</ScrollViewer>
		</Border>

		<!-- Status bar -->
		<StatusBar Grid.Row="2" Background="#2A2A2A" Foreground="White" BorderThickness="0">
			<TextBlock Name="StatusText" Text="Ready." FontWeight="SemiBold" />
		</StatusBar>
	</Grid>
</Window>
