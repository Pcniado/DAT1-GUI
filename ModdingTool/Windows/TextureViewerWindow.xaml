<Controls:MetroWindow x:Class="ModdingTool.Windows.TextureViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
        Title="Texture Viewer"
        Height="600" Width="800"
        WindowStartupLocation="CenterScreen"
        WindowTitleBrush="{DynamicResource AppTitleBarGradient}"
        BorderThickness="0"
        GlowBrush="{x:Null}">
    <Controls:MetroWindow.Resources>
        <Style x:Key="RoundedButtonStyle" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Controls:MetroWindow.Resources>
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#EEE" Offset="0.0"/>
                <GradientStop Color="#EEE" Offset="1.0"/>
            </LinearGradientBrush>
        </Grid.Background>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Metro-style button stack -->
        <StackPanel Orientation="Horizontal" Margin="16,16,16,8" Grid.Row="0" HorizontalAlignment="Left">
            <Button Content="Browse Texture"
                        Click="OnBrowseTexture_Click"
                        Width="140"
                        Height="36"
                        Margin="0,0,12,0"
                        BorderThickness="0"
                        BorderBrush="Transparent"/>
                <Button Content="Export PNG"
                        Click="OnExportPng_Click"
                        Width="140"
                        Height="36"
                        Margin="0,0,12,0"
                        BorderThickness="0"
                        BorderBrush="Transparent"/>
                <Button Content="Import PNG"
                        Click="OnImportPng_Click"
                        Width="140"
                        Height="36"
                        BorderThickness="0"
                        BorderBrush="Transparent"/>
                </StackPanel>

        <!-- Image preview area -->
        <Border Grid.Row="1"
                Margin="16"
                CornerRadius="8"
                BorderBrush="#DDD"
                BorderThickness="1"
                Background="#FFF">
            <ScrollViewer x:Name="ImageScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Image Name="TextureImage" Stretch="Uniform"/>
            </ScrollViewer>
        </Border>

        <!-- Status bar -->
        <StatusBar Grid.Row="2" Background="#F3F3F3" Foreground="#222" BorderThickness="0" Height="28">
            <TextBlock Name="StatusText" Text="Ready." FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StatusBar>
    </Grid>
</Controls:MetroWindow>
