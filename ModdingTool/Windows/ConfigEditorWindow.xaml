<Window x:Class="ModdingTool.Windows.ConfigEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        Title="Config Editor" Height="600" Width="800" MinHeight="400" MinWidth="600">
    <Grid>
        <Grid x:Name="Overlay" Panel.ZIndex="1000" Visibility="Collapsed">
            <Grid.Background>
                <SolidColorBrush Color="Black" Opacity="0.75"/>
            </Grid.Background>
            <Grid HorizontalAlignment="Stretch" VerticalAlignment="Center" Height="80" Background="#FFF">
                <TextBlock x:Name="OverlayHeaderLabel" Text="Decoding config..." HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="18" Margin="25,15,0,0" />
            </Grid>
        </Grid>
        <DockPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="8">
                <Button x:Name="OpenButton" Content="Open..." Width="80" Margin="0,0,8,0" Click="OpenButton_Click" />
                <Button x:Name="SaveConfigButton" Content="Save as .config" Width="120" Margin="0,0,8,0" Click="SaveConfigButton_Click" />
                <Button x:Name="SaveJsonButton" Content="Save as JSON" Width="120" Margin="0,0,8,0" Click="SaveJsonButton_Click" />
                <Button x:Name="AddToModButton" Content="Add to .stage" Width="150" Margin="0,0,8,0" Click="AddToModButton_Click" Visibility="Collapsed" />
                <TextBlock x:Name="StatusText" Margin="16,0,0,0" VerticalAlignment="Center" Foreground="Gray" />
            </StackPanel>
            <avalonedit:TextEditor x:Name="JsonEditor" FontFamily="Consolas" FontSize="14" ShowLineNumbers="True" SyntaxHighlighting="JavaScript" Margin="8"/>
        </DockPanel>
    </Grid>
</Window> 