<Controls:MetroWindow x:Class="ModdingTool.Windows.CustomMessageBox"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:Controls="http://metro.mahapps.com/winfx/xaml/controls"
        Title="Message" Height="180" Width="350" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        GlowBrush="{x:Null}"
        WindowTitleBrush="{DynamicResource AppTitleBarGradient}"
        BorderThickness="0">
    <Controls:MetroWindow.Resources>
        <SolidColorBrush x:Key="AccentColorBrush" Color="#FF888888"/>
    </Controls:MetroWindow.Resources>
    <Grid Margin="10" Background="#232323">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="MessageText" TextWrapping="Wrap" FontSize="15" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center" TextAlignment="Center" Foreground="#eee"/>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="OkButton" Content="OK" Width="70" Margin="0,0,10,0" Click="Ok_Click"/>
            <Button x:Name="CancelButton" Content="Cancel" Width="70" Click="Cancel_Click" Visibility="Collapsed"/>
        </StackPanel>
    </Grid>
</Controls:MetroWindow> 